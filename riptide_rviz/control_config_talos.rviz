Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Mapping Markers1/Namespaces1
      Splitter Ratio: 0.5276073813438416
    Tree Height: 414
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
  - Class: riptide_rviz/ControlPanel
    Name: ControlPanel
    max_depth_in_place: -0.5
    odom_timeout: 2.5
    robot_namespace: /talos
    tgt_in_place_depth: -0.75
  - Class: riptide_rviz/MappingPanel
    Name: MappingPanel
    mapCalibNumSamples: 10
    robot_namespace: /talos
    tagFrameName: estimated_origin_frame
    worldFrameName: world
  - Class: riptide_rviz/ElectricalPanel
    Name: ElectricalPanel
    robot_namespace: /talos
  - Class: riptide_rviz/MissionPanel
    Name: MissionPanel
    robot_namespace: /talos
  - Class: riptide_rviz/FeedforwardPanel
    Name: FeedforwardPanel
    robot_namespace: /talos
  - Class: riptide_rviz/BaggingPanel
    Name: BaggingPanel
  - Class: riptide_rviz/ParamPanel
    Name: ParamPanel
    robot_namespace: /talos
  - Class: riptide_rviz/Actuators
    Name: Actuators
    robot_namespace: /talos
  - Class: riptide_rviz/DiagnosticsPanel
    Name: DiagnosticsPanel
    robot_namespace: /talos
  - Class: riptide_rviz/RosbagPanel
    Name: RosbagPanel
    robot_namespace: ""
  - Class: riptide_rviz/ServicePanel
    Name: ServicePanel
    robot_namespace: ""
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 0.699999988079071
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: FFC Point Cloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.009999999776482582
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /talos/ffc/zed_node/point_cloud/cloud_registered
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 0.699999988079071
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: false
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: DFC Point Cloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.009999999776482582
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /talos/dfc/zed_node/point_cloud/cloud_registered
      Use Fixed Frame: true
      Use rainbow: true
      Value: false
    - Class: riptide_rviz/DiagnosticOverlay
      Enabled: true
      Name: DiagnosticOverlay
      Value: true
      diagnostic_timeout: 10
      font: DejaVu Sans Mono
      height: 200
      hor_alignment: left
      hor_dist: 0
      robot_namespace: /talos
      ver_alignment: top
      ver_dist: 0
      width: 220
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        ghost/base_link:
          Value: false
        ghost/origin:
          Value: false
        world:
          Value: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /talos/robot_description
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Mass Properties:
        Inertia: false
        Mass: false
      Name: RobotModel
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Mapping Markers
      Namespaces:
        mapping_markers: true
        simGhost: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /talos/mapping_markers
      Value: true
    - Class: rviz_default_plugins/InteractiveMarkers
      Enable Transparency: true
      Enabled: true
      Interactive Markers Namespace: /interactive_setpoint
      Name: Interactive Setpoint
      Show Axes: false
      Show Descriptions: true
      Show Visual Aids: false
      Value: true
